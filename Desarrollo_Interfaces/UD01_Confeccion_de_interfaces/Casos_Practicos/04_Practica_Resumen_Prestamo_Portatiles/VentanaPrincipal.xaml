             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="VentanaPrincipal.xaml">
    <Application.Resources>

        <!-- Colores comunes de la aplicación: úsalos con {StaticResource ...} -->
        <SolidColorBrush x:Key="ColorPrincipal" Color="#0F6CBD"/>
