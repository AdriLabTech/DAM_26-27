<Window x:Class="PrestamosGC.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préstamo de portátiles · Dpto. de Informática"
        Width="760" Height="520" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <!-- Cinco filas: cabecera, filtros, lista (la única que crece), botones y barra de estado -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Cabecera ===== -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Recursos/portatil.png" Height="48" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Préstamos de portátiles" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Departamento de Informática · IES Gran Capitán"
                           Foreground="{StaticResource ColorTextoSecundario}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Filtros ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,4,20,8">
            <TextBlock Text="Mostrar:" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <RadioButton x:Name="rbTodos" Content="Todos" GroupName="Filtro" IsChecked="True"
                         Margin="0,0,20,0" VerticalContentAlignment="Center" Checked="Filtro_Checked"/>
            <RadioButton x:Name="rbActivos" Content="En préstamo" GroupName="Filtro"
                         Margin="0,0,20,0" VerticalContentAlignment="Center" Checked="Filtro_Checked"/>
            <RadioButton x:Name="rbVencidos" Content="Vencidos" GroupName="Filtro"
                         Margin="0,0,20,0" VerticalContentAlignment="Center" Checked="Filtro_Checked"/>
            <RadioButton x:Name="rbDevueltos" Content="Devueltos" GroupName="Filtro"
                         VerticalContentAlignment="Center" Checked="Filtro_Checked"/>
        </StackPanel>

        <!-- ===== Lista ===== -->
        <ListBox x:Name="lstPrestamos" Grid.Row="2" Margin="20,0,20,0"
                 DisplayMemberPath="Resumen" SelectionMode="Single"
                 SelectionChanged="lstPrestamos_SelectionChanged"
                 MouseDoubleClick="lstPrestamos_MouseDoubleClick"/>

        <!-- ===== Botones ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,12">
            <Button x:Name="btnDetalle" Content="Ver detalle" IsEnabled="False" Click="btnDetalle_Click"/>
            <Button x:Name="btnNuevo" Content="Nuevo préstamo" Style="{StaticResource BotonPrincipal}"
                    Click="btnNuevo_Click"/>
        </StackPanel>

        <!-- ===== Barra de estado ===== -->
        <Border Grid.Row="4" Background="{StaticResource ColorFondoBarra}" Padding="20,6">
            <TextBlock x:Name="txtEstado" Foreground="{StaticResource ColorTextoSecundario}"/>
        </Border>
    </Grid>
</Window>
