<Window x:Class="PrestamosGC.VentanaPrestamo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo préstamo"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Border Padding="24,16">
        <StackPanel>

            <!-- ===== Cabecera ===== -->
            <TextBlock Text="Nuevo préstamo" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Rellena los datos del alumno y del portátil"
                       Foreground="{StaticResource ColorTextoSecundario}"/>

            <!-- ===== Formulario: ocho campos en dos columnas iguales ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 0: nombre y apellidos -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtNombre" TabIndex="0" TextChanged="Texto_Changed"/>
                    <TextBlock x:Name="txtErrorNombre" Style="{StaticResource MensajeError}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Apellidos" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtApellidos" TabIndex="1" TextChanged="Texto_Changed"/>
                    <TextBlock x:Name="txtErrorApellidos" Style="{StaticResource MensajeError}"/>
                </StackPanel>

                <!-- Fila 1: grupo y correo -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Grupo" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cmbGrupo" TabIndex="2" SelectionChanged="Combo_SelectionChanged">
                        <ComboBoxItem Content="1º DAM"/>
                        <ComboBoxItem Content="2º DAM"/>
                        <ComboBoxItem Content="1º DAW"/>
                        <ComboBoxItem Content="2º DAW"/>
                        <ComboBoxItem Content="1º ASIR"/>
                        <ComboBoxItem Content="2º ASIR"/>
                    </ComboBox>
                    <TextBlock x:Name="txtErrorGrupo" Style="{StaticResource MensajeError}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Correo del centro" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtCorreo" TabIndex="3" TextChanged="Texto_Changed"/>
                    <TextBlock x:Name="txtErrorCorreo" Style="{StaticResource MensajeError}"/>
                </StackPanel>

                <!-- Fila 2: portátil y motivo -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Portátil" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cmbPortatil" TabIndex="4" SelectionChanged="Combo_SelectionChanged"/>
                    <TextBlock x:Name="txtErrorPortatil" Style="{StaticResource MensajeError}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Motivo" Style="{StaticResource Etiqueta}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton x:Name="rbProyecto" Content="Proyecto" GroupName="Motivo" TabIndex="5"
                                     Margin="0,0,16,0" Checked="Motivo_Checked"/>
                        <RadioButton x:Name="rbPracticas" Content="Prácticas" GroupName="Motivo" TabIndex="6"
                                     Margin="0,0,16,0" Checked="Motivo_Checked"/>
                        <RadioButton x:Name="rbOtro" Content="Otro" GroupName="Motivo" TabIndex="7"
                                     Checked="Motivo_Checked"/>
                    </StackPanel>
                    <TextBlock x:Name="txtErrorMotivo" Style="{StaticResource MensajeError}"/>
                </StackPanel>

                <!-- Fila 3: fechas -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Fecha de préstamo" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="dpPrestamo" TabIndex="8" SelectedDateChanged="dpPrestamo_SelectedDateChanged"/>
                    <TextBlock x:Name="txtErrorPrestamo" Style="{StaticResource MensajeError}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Fecha de devolución" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="dpDevolucion" TabIndex="9" SelectedDateChanged="dpDevolucion_SelectedDateChanged"/>
                    <TextBlock x:Name="txtErrorDevolucion" Style="{StaticResource MensajeError}"/>
                </StackPanel>

                <!-- Fila 4: cargador (ocupa las dos columnas) -->
                <CheckBox x:Name="chkCargador" Grid.Row="4" Grid.ColumnSpan="2" TabIndex="10"
                          Content="Incluye cargador" IsChecked="True" Margin="0,12,0,0"/>

                <!-- Fila 5: observaciones y contador (ocupan las dos columnas) -->
                <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                    <TextBlock x:Name="lblObservaciones" Text="Observaciones" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="txtObservaciones" TabIndex="11" Height="64"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MaxLength="200"
                             VerticalContentAlignment="Top" TextChanged="txtObservaciones_TextChanged"/>
                    <TextBlock x:Name="txtErrorObservaciones" Style="{StaticResource MensajeError}"/>
                    <TextBlock x:Name="txtContador" Text="0/200" HorizontalAlignment="Right"
                               Foreground="{StaticResource ColorTextoSecundario}"/>
                </StackPanel>

                <!-- Fila 6: normas (ocupan las dos columnas) -->
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <CheckBox x:Name="chkNormas" TabIndex="12"
                              Content="El alumno conoce y acepta las normas de uso de los portátiles"
                              Checked="Normas_Changed" Unchecked="Normas_Changed"/>
                    <TextBlock x:Name="txtErrorNormas" Style="{StaticResource MensajeError}"/>
                </StackPanel>
            </Grid>

            <!-- ===== Error general ===== -->
            <TextBlock x:Name="txtErrorGeneral" Style="{StaticResource MensajeError}" Margin="0,12,0,0"/>

            <!-- ===== Botones ===== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar" IsCancel="True" TabIndex="14"/>
                <Button x:Name="btnRegistrar" Content="Registrar préstamo" IsDefault="True" TabIndex="13"
                        Style="{StaticResource BotonPrincipal}" Click="Registrar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
