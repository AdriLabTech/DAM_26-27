<Window
    x:Class="controlesTexto.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Controles de Texto"
    Width="500"
    Height="500">

    <Grid>
        <StackPanel>
            <!-- Nombre -->
            <Label Content="Nombre:"/>
            <TextBox x:Name="txtNombre" Width="200" Height="25" TextChanged="TextChanged"/>

            <!-- Contraseña -->
            <Label Content="Contraseña:"/>
            <PasswordBox Width="200" Height="25"/>

            <!--  -->
        </StackPanel>
    </Grid>
</Window>