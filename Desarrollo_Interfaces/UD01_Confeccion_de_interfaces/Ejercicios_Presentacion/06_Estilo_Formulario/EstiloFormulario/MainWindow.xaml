<Window
    x:Class="EstiloFormulario.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:EstiloFormulario"
    Title="Formulario con estilo"
    Width="760"
    Height="420">

    <Window.DataContext>
        <local:FormularioViewModel/>
    </Window.DataContext>

    <Grid Margin="{StaticResource MargenVentana}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Formulario (actividad 2.5 A) -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Ficha de usuario" Style="{StaticResource TituloSeccion}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Nombre:"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="1" Content="Correo:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="2" Content="Ciudad:"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding Ciudades}" SelectedItem="{Binding Ciudad}"/>
            </Grid>

            <CheckBox Content="Acepto las condiciones" IsChecked="{Binding Aceptado}" Margin="0,0,0,14"/>

            <Button Content="Guardar" Style="{StaticResource Primario}"
                    Command="{Binding GuardarCommand}" HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding Resumen}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- Lista (actividad 2.7) con DataTemplate -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Anotaciones" Style="{StaticResource TituloSeccion}"/>
            <ListBox ItemsSource="{Binding Anotaciones}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:Anotacion}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Celsius, StringFormat={}{0:0.##} °C}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Fahrenheit, StringFormat={}{0:0.##} °F}"
                                       Opacity="0.75"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
