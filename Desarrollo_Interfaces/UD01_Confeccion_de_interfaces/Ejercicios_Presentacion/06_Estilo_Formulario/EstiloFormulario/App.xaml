<Application
    x:Class="EstiloFormulario.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ThemeMode="System"
    StartupUri="MainWindow.xaml">

    <!-- Paso 1: ThemeMode="System" sigue el tema claro/oscuro del sistema (None, Light, Dark o System) -->
    <Application.Resources>

        <!-- Paso 2: colores y márgenes como recursos, definidos una sola vez -->
        <Color x:Key="ColorPrimario">#2563EB</Color>
        <Color x:Key="ColorPrimarioHover">#1D4ED8</Color>
        <Color x:Key="ColorTextoPrimario">#FFFFFF</Color>
        <SolidColorBrush x:Key="PincelPrimario" Color="{StaticResource ColorPrimario}"/>
        <SolidColorBrush x:Key="PincelPrimarioHover" Color="{StaticResource ColorPrimarioHover}"/>
        <SolidColorBrush x:Key="PincelTextoPrimario" Color="{StaticResource ColorTextoPrimario}"/>

        <Thickness x:Key="MargenVentana">20</Thickness>
        <Thickness x:Key="MargenCampo">0,0,0,10</Thickness>
        <Thickness x:Key="MargenEtiqueta">0,0,10,10</Thickness>
        <Thickness x:Key="PaddingCampo">6,4</Thickness>
        <CornerRadius x:Key="RadioEsquina">6</CornerRadius>

        <!-- Los campos comparten margen y relleno sin repetirlos en cada control -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="{StaticResource MargenCampo}"/>
            <Setter Property="Padding" Value="{StaticResource PaddingCampo}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="{StaticResource MargenCampo}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="{StaticResource MargenEtiqueta}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Paso 3: estilo «Primario» para el botón principal -->
        <Style x:Key="Primario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PincelPrimario}"/>
            <Setter Property="Foreground" Value="{StaticResource PincelTextoPrimario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadioEsquina}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Background" Value="{StaticResource PincelPrimarioHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Título de sección: usa el color de texto del tema, así funciona en claro y oscuro -->
        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Application.Resources>

</Application>
