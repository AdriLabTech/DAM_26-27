<Window
    x:Class="AgendaAmpliada.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Agenda de contactos"
    Width="760"
    Height="460"
    MinWidth="560"
    MinHeight="300">

    <!-- Atajos: el mismo comando sirve al botón y al teclado -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NuevoCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditarCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding EliminarCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ExportarCsvCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Nuevo (Ctrl+N)" Command="{Binding NuevoCommand}"/>
            <Button Content="Editar (Ctrl+E)" Command="{Binding EditarCommand}"/>
            <Button Content="Eliminar (Supr)" Command="{Binding EliminarCommand}"/>
            <Separator/>
            <Button Content="Exportar a CSV (Ctrl+S)" Command="{Binding ExportarCsvCommand}"/>
            <Separator/>
            <Button Content="{Binding TextoTema}" Command="{Binding CambiarTemaCommand}"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding Estado}"/>
        </StatusBar>

        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <Label Content="Buscar:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
        </DockPanel>

        <!-- Cero manejadores de eventos: todo son Binding y Command -->
        <DataGrid ItemsSource="{Binding Vista}"
                  SelectedItem="{Binding Seleccionado}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="8,4,8,8">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditarCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
