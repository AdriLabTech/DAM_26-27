<Application
    x:Class="AgendaAmpliada.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ThemeMode="Light"
    StartupUri="MainWindow.xaml">

    <Application.Resources>
        <!-- Los campos del diálogo comparten margen y relleno -->
        <Style x:Key="CampoDialogo" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Mensaje de error visible bajo el campo (validación del ObservableValidator) -->
        <Style x:Key="ErrorCampo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Application.Resources>

</Application>
